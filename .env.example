#psql db settings
POSTGRES_USER=DB_USER
POSTGRES_PASSWORD=DB_PASSWORD
POSTGRES_DB=DB
DB_URL=postgresql+asyncpg://DB_USER:DB_PASSWORD@db:5432/DB

#db pool settings
POOL_SIZE = 5
MAX_OVERFLOW = 5
POOL_TIMEOUT = 30

